{
  "id": "market.petabyte.render",
  "name": "Petabyte Render",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    { "app": "premierepro", "minVersion": "25.6" }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "pbpanel",
      "label": { "default": "Petabyte Render" },
      "minimumSize": { "width": 200, "height": 100 },
      "preferredDockedSize": { "width": 260, "height": 140 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": ["http://127.0.0.1:47811"] },
    "localFileSystem": "plugin"
  }
}

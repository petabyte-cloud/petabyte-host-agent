# No mining during install/update. Explicit seller opt-in required.
PETABYTE_IDLE_MINING=true
DOGE_ADD=
PETABYTE_MINING_WORKER=pb-CHANGE-ME
# Locally-built GPU miner image ID (sha256), never a mutable tag or third-party auto-download.
PETABYTE_GPU_MINING_IMAGE=
# Exactly one NVIDIA GPU UUID (nvidia-smi --query-gpu=uuid --format=csv,noheader).
PETABYTE_MINING_GPU_UUID=
# DOGE is a pool-conversion payout (FishHash via unMineable). Explicit opt-in acknowledges
# the pool's own fees and payout thresholds.
PETABYTE_DOGE_POOL_CONVERSION=true
# Pool wallet must be exclusive to this machine's worker (no shared/referral income).
PETABYTE_MINING_DEDICATED_WALLETS=false
# Blocks NEW rentals until valid data arrives; existing rentals are unchanged.
PETABYTE_MINING_FLOOR=false
